# Nonworking prerelease template. Replace every RELEASE_* placeholder before use.
name: Source review
on:
  pull_request:
permissions: {}
concurrency:
  group: breaklint-${{ github.event.pull_request.number }}
  cancel-in-progress: false
jobs:
  fork-unavailable:
    if: github.event.pull_request.head.repo.id != github.event.repository.id
    runs-on: ubuntu-latest
    steps:
      - run: |
          echo "Breaklint unavailable: fork service authorization is not provisioned."
          exit 1
  source-review:
    if: github.event.pull_request.head.repo.id == github.event.repository.id
    runs-on: ubuntu-latest
    permissions:
      contents: read
      actions: read
      checks: write
    steps:
      - uses: actions/checkout@RELEASE_VERIFIED_CHECKOUT_COMMIT
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: RELEASE_PUBLIC_OWNER/RELEASE_PUBLIC_REPOSITORY/action@RELEASE_FULL_COMMIT
        with:
          service-url: https://SERVICE_NOT_PROVISIONED.invalid
          service-token: ${{ secrets.BREAKLINT_SERVICE_TOKEN }}
          github-token: ${{ github.token }}
          inline: "false"
