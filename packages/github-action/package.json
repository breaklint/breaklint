{
  "name": "@breaklint/github-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@breaklint/hosted-client": "workspace:*",
    "@breaklint/public-config": "workspace:*",
    "@breaklint/public-protocol": "workspace:*"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "Unicode-License.txt",
    "LICENSE.md",
    "NOTICE"
  ],
  "description": "Publish hosted Breaklint source review results on GitHub pull requests.",
  "engines": {
    "node": "22.14.0 || 24.21.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/breaklint/breaklint.git",
    "directory": "packages/github-action"
  },
  "homepage": "https://github.com/breaklint/breaklint#readme",
  "bugs": {
    "url": "https://github.com/breaklint/breaklint/issues"
  }
}
