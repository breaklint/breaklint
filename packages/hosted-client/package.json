{
  "name": "@breaklint/hosted-client",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "Unicode-License.txt",
    "LICENSE.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@breaklint/public-protocol": "workspace:*",
    "ignore": "7.0.6"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.1"
  },
  "description": "Authenticated client and committed-source packaging for Breaklint.",
  "engines": {
    "node": "22.14.0 || 24.21.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/breaklint/breaklint.git",
    "directory": "packages/hosted-client"
  },
  "homepage": "https://github.com/breaklint/breaklint#readme",
  "bugs": {
    "url": "https://github.com/breaklint/breaklint/issues"
  }
}
