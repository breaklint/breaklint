{
  "name": "@breaklint/hosted-client",
  "version": "0.1.0-rc.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "Unicode-License.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@breaklint/public-protocol": "workspace:*",
    "ignore": "7.0.6"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.1"
  },
  "description": "Authenticated client and committed-source packaging for Breaklint.",
  "engines": {
    "node": "22.14.0 || 24.21.0"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}
